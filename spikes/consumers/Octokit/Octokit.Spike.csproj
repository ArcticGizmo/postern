<Project Sdk="Microsoft.NET.Sdk">

  <!-- C2: a third-party SDK (Octokit.NET) pointed at Postern with no changes to the SDK, only its HTTP plumbing. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>octokit-spike</AssemblyName>
    <RootNamespace>OctokitSpike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Postern.Client\Postern.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octokit" Version="14.0.0" />
  </ItemGroup>

</Project>
