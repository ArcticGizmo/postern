<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Both spike exes land in one folder so the probe can find (and verify the path of) the broker next to it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutDir>$(MSBuildThisFileDirectory)out\</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
