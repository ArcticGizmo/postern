<Project Sdk="Microsoft.NET.Sdk">

  <!-- The request path: named-pipe Kestrel host, caller identity, policy enforcement, auth injection, storage.
       A library so the tray app can host it in-process and tests can run it on a throwaway pipe. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Postern.Broker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PipeProcess.cs" Link="Interop\PipeProcess.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Postern.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postern.Core\Postern.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
