<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sallyport: the test bed's companion app. Sends a library of request shapes through Postern (Sandbox) and checks
       each against what should happen, soaks while Postern is crashed and restarted, and has a headless run-all for CI.
       It references Postern.Client only, never the broker, so it sees Postern exactly as any other app does. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>sallyport</AssemblyName>
    <RootNamespace>Postern.Sallyport</RootNamespace>
    <ApplicationIcon>Assets/sallyport.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <None Include="scenarios/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Postern.Tests" />
    <InternalsVisibleTo Include="postern-snapshots" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Postern.Client\Postern.Client.csproj" />
  </ItemGroup>

</Project>
